{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "palette": {
    "rosewater": "#f4dbd6",
    "flamingo": "#f0c6c6",
    "pink": "#f5bde6",
    "mauve": "#c6a0f6",
    "red": "#ed8796",
    "maroon": "#ee99a0",
    "peach": "#f5a97f",
    "yellow": "#eed49f",
    "green": "#a6da95",
    "teal": "#8bd5ca",
    "sky": "#91d7e3",
    "sapphire": "#7dc4e4",
    "blue": "#8aadf4",
    "lavender": "#b7bdf8",
    "text": "#cad3f5",
    "subtext1": "#b8c0e0",
    "subtext0": "#a5adcb",
    "overlay2": "#939ab7",
    "overlay1": "#8087a2",
    "overlay0": "#6e738d",
    "surface2": "#5b6078",
    "surface1": "#494d64",
    "surface0": "#363a4f",
    "base": "#24273a",
    "mantle": "#1e2030",
    "crust": "#181926"
  },
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:red",
          "template": ""
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:crust",
          "background": "p:red",
          "template": "{{ if eq .UserName \"sahi_no\" }}{{ else }}{{ .UserName }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:red",
          "background": "p:peach",
          "template": ""
        },
        {
          "type": "path",
          "style": "plain",
          "background": "p:peach",
          "foreground": "p:crust",
          "template": " {{ .Path }} ",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 2,
            "mapped_locations": {
              "~/Documents": "󰈙",
              "~/Downloads": "",
              "~/Music": "󰝚",
              "~/Pictures": "",
              "~/projects/*": "󰲋"
            },
            "folder_separator_icon": "  "
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:peach",
          "background": "p:yellow",
          "template": ""
        },
        {
          "type": "git",
          "style": "plain",
          "background": "p:yellow",
          "foreground": "p:crust",
          "template": " {{ .HEAD }} ",
          "properties": {
            "fetch_status": true,
            "branch_icon": " ",
            "commit_icon": " ",
            "tag_icon": " ",
            "rebase_icon": " ",
            "cherry_pick_icon": " ",
            "revert_icon": " ",
            "merge_icon": " ",
            "no_commits_icon": " "
          }
        },
        {
          "type": "git",
          "style": "plain",
          "background": "p:yellow",
          "foreground": "p:crust",
          "template": " {{ .Working.String }}{{ if and (.Working.Changed) (.Staging.Changed) }} | {{ end }}{{ .Staging.String }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:yellow",
          "background": "p:green",
          "template": ""
        },
        {
          "type": "c",
          "style": "plain",
          "background": "p:green",
          "foreground": "p:crust",
          "template": "  {{ if .Full }}{{ .Full }}{{ end }} "
        },
        {
          "type": "rust",
          "style": "plain",
          "background": "p:green",
          "foreground": "p:crust",
          "template": "  {{ .Full }} "
        },
        {
          "type": "go",
          "style": "plain",
          "background": "p:green",
          "foreground": "p:crust",
          "template": "  {{ .Full }} "
        },
        {
          "type": "node",
          "style": "plain",
          "background": "p:green",
          "foreground": "p:crust",
          "template": "  {{ .Full }} "
        },
        {
          "type": "php",
          "style": "plain",
          "background": "p:green",
          "foreground": "p:crust",
          "template": "  {{ .Full }} "
        },
        {
          "type": "java",
          "style": "plain",
          "background": "p:green",
          "foreground": "p:crust",
          "template": "  {{ .Full }} "
        },
        {
          "type": "kotlin",
          "style": "plain",
          "background": "p:green",
          "foreground": "p:crust",
          "template": "  {{ .Full }} "
        },
        {
          "type": "haskell",
          "style": "plain",
          "background": "p:green",
          "foreground": "p:crust",
          "template": "  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "background": "p:green",
          "foreground": "p:crust",
          "template": "  {{ if .Venv }}(#{{ .Venv }}){{ end }}{{ if .Full }} {{ .Full }}{{ end }} ",
          "properties": {
            "display_mode": "environment"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "background": "p:sapphire",
          "template": ""
        },
        {
          "type": "docker",
          "style": "plain",
          "background": "p:sapphire",
          "foreground": "p:crust",
          "template": "  {{ .Context }} "
        },
        {
          "type": "conda",
          "style": "plain",
          "background": "p:sapphire",
          "foreground": "p:crust",
          "template": "  {{ .Environment }} ",
          "properties": {
            "display_mode": "environment"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:sapphire",
          "template": " "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "template": "❯"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "p:lavender",
          "foreground": "p:crust",
          "template": "  {{ .FormattedMs }} ",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:blue",
          "template": " {{ .CurrentDate | date \"15:04\" }} ",
          "background_templates": [
            "{{ if or (ge (atoi (date \"15\")) 17) (and (eq (atoi (date \"15\")) 17) (ge (atoi (date \"04\")) 30)) }}p:red{{ else }}p:blue{{ end }}"
          ],
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ else }}p:green{{ end }}"
    ],
    "template": "❯ "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:yellow",
    "template": "❯❯ "
  }
}
